From: ASUS Zenbook A14 Linux support
Subject: [PATCH] power: understand A14 Quiet and Full Speed profiles

GNOME Control Center 50 hard-codes exactly three power-profile enum values and
silently ignores unknown profile names returned by power-profiles-daemon.
Extend the existing Power Mode section to support the A14's validated five
profiles while preserving GNOME Settings' stock row presentation. Profile
icons remain a GNOME Shell Quick Settings concern and are not added here.

--- a/panels/power/cc-power-profile-row.h
+++ b/panels/power/cc-power-profile-row.h
@@ -28,9 +28,11 @@ G_BEGIN_DECLS
 
 typedef enum
 {
+  CC_POWER_PROFILE_FULL_SPEED,
   CC_POWER_PROFILE_PERFORMANCE,
   CC_POWER_PROFILE_BALANCED,
   CC_POWER_PROFILE_POWER_SAVER,
+  CC_POWER_PROFILE_QUIET,
   NUM_CC_POWER_PROFILES,
   /* The unknown profile is intentionally not counted as a profile. It exists to handle unsupported profiles. */
   CC_POWER_PROFILE_UNKNOWN
--- a/panels/power/cc-power-profile-row.c
+++ b/panels/power/cc-power-profile-row.c
@@ -106,6 +106,10 @@ cc_power_profile_row_new (CcPowerProfile power_profile)
   self->power_profile = power_profile;
   switch (self->power_profile)
     {
+      case CC_POWER_PROFILE_FULL_SPEED:
+        text = C_("Power profile", "_Full Speed");
+        subtext = _("Maximum cooling and no artificial CPU frequency cap");
+        break;
       case CC_POWER_PROFILE_PERFORMANCE:
         text = C_("Power profile", "P_erformance");
         subtext = _("High performance and power usage");
@@ -118,6 +122,10 @@ cc_power_profile_row_new (CcPowerProfile power_profile)
         text = C_("Power profile", "P_ower Saver");
         subtext = _("Reduced performance and power usage");
         break;
+      case CC_POWER_PROFILE_QUIET:
+        text = C_("Power profile", "_Quiet");
+        subtext = _("Acoustic-first mode with strong CPU throttling");
+        break;
       default:
         g_assert_not_reached ();
     }
@@ -127,12 +135,16 @@ cc_power_profile_from_str (const char *profile)
 {
+  if (g_strcmp0 (profile, "full-speed") == 0)
+    return CC_POWER_PROFILE_FULL_SPEED;
   if (g_strcmp0 (profile, "power-saver") == 0)
     return CC_POWER_PROFILE_POWER_SAVER;
   if (g_strcmp0 (profile, "balanced") == 0)
     return CC_POWER_PROFILE_BALANCED;
   if (g_strcmp0 (profile, "performance") == 0)
     return CC_POWER_PROFILE_PERFORMANCE;
+  if (g_strcmp0 (profile, "quiet") == 0)
+    return CC_POWER_PROFILE_QUIET;
 
   g_warning ("Unknown power profile: %s", profile);
 
@@ -144,12 +156,16 @@ cc_power_profile_to_str (CcPowerProfile profile)
 {
   switch (profile)
   {
+  case CC_POWER_PROFILE_FULL_SPEED:
+    return "full-speed";
   case CC_POWER_PROFILE_POWER_SAVER:
     return "power-saver";
   case CC_POWER_PROFILE_BALANCED:
     return "balanced";
   case CC_POWER_PROFILE_PERFORMANCE:
     return "performance";
+  case CC_POWER_PROFILE_QUIET:
+    return "quiet";
   default:
     g_assert_not_reached ();
   }
