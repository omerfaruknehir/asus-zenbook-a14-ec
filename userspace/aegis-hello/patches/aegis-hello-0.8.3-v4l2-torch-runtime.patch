+def _find_v4l2_flash_device() -> str:
+    """Find the PM8550 V4L2 flash subdevice that owns Torch mode."""
+    tool = shutil.which("v4l2-ctl")
+    if not tool:
+        raise CaptureConfigurationError("v4l2-ctl is required for HM1092 continuous infrared")
+    for candidate in sorted(glob.glob("/dev/v4l-subdev*")):
+        completed = subprocess.run(
+            [tool, "-d", candidate, "--list-ctrls-menus"],
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False, timeout=2.0,
+        )
+        controls = completed.stdout or ""
+        if completed.returncode == 0 and "led_mode" in controls and "intensity_torch_mode" in controls:
+            return candidate
+    raise CaptureConfigurationError("HM1092 V4L2 flash/torch subdevice is missing")
+
+
+def _v4l2_torch_range(device: str) -> tuple[int, int, int]:
+    tool = shutil.which("v4l2-ctl")
+    assert tool is not None
+    completed = subprocess.run(
+        [tool, "-d", device, "--list-ctrls"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False, timeout=2.0,
+    )
+    if completed.returncode != 0:
+        raise CaptureConfigurationError(
+            f"Cannot query HM1092 V4L2 torch controls: {(completed.stderr or '').strip()}"
+        )
+    match = re.search(
+        r"^\s*intensity_torch_mode\s+[^:]+:\s+min=(\d+)\s+max=(\d+)\s+step=(\d+)",
+        completed.stdout or "", re.MULTILINE,
+    )
+    if not match:
+        raise CaptureConfigurationError("HM1092 V4L2 torch current range is unavailable")
+    minimum, maximum, step = map(int, match.groups())
+    return minimum, maximum, step
+
+
+def _set_v4l2_controls(device: str, controls: str) -> None:
+    tool = shutil.which("v4l2-ctl")
+    assert tool is not None
+    completed = subprocess.run(
+        [tool, "-d", device, f"--set-ctrl={controls}"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False, timeout=2.0,
+    )
+    if completed.returncode != 0:
+        detail = (completed.stderr or completed.stdout or "V4L2 control write failed").strip()
+        raise CaptureConfigurationError(f"Cannot control HM1092 IR torch: {detail}")
+
+
+def _get_v4l2_control(device: str, control: str) -> int:
+    tool = shutil.which("v4l2-ctl")
+    assert tool is not None
+    completed = subprocess.run(
+        [tool, "-d", device, f"--get-ctrl={control}"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False, timeout=2.0,
+    )
+    if completed.returncode != 0:
+        raise CaptureConfigurationError(f"Cannot read HM1092 V4L2 control {control}")
+    match = re.search(r":\s*(-?\d+)\s*$", completed.stdout or "")
+    if not match:
+        raise CaptureConfigurationError("Invalid HM1092 V4L2 control value for {control}")
+    return int(match.group(1))
+
+
