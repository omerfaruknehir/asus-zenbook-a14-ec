+		},
 		.capture = {
@@ -2311,6 +2325,11 @@ static const struct snd_soc_dapm_widget wsa_macro_dapm_widgets[] = {
 	SND_SOC_DAPM_AIF_OUT_E("WSA AIF_VI", "WSA_AIF_VI Capture", 0,
 			       SND_SOC_NOPM, WSA_MACRO_AIF_VI, 0,
