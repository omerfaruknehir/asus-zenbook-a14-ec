From: ASUS Zenbook A14 Linux bring-up
Subject: [PATCH] ASoC: qcom: x1e80100: add A14 WSA884x VISENSE transport

Add the physical two-channel WSA884x VISENSE sidechain for the ASUS
Zenbook A14 UX3407RA.  This is transport-only: the existing X1E80100
speaker gain safety limits remain in place until an AudioReach SP/SPVI
protection graph is verified live on this machine.

The A14 DTS already maps WSA8845 VISENSE to SoundWire master ports 10 and
11.  Expose one render-coupled 8 kHz/S32 two-channel backend through
WSA_CODEC_DMA_TX_0, while retaining the physical slave-to-master direction.

Do not raise PA or digital gain in this patch.
---
 Documentation/devicetree/bindings/sound/qcom,wsa8840.yaml |  7 +-
 arch/arm64/boot/dts/qcom/x1-asus-zenbook-a14.dtsi          | 28 +++++-
 drivers/soundwire/qcom.c                                   | 35 +++++--
 sound/soc/codecs/lpass-wsa-macro.c                         | 22 ++++-
 sound/soc/codecs/wsa884x.c                                 | 98 ++++++++++++--------
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c                  | 29 +++++-
 sound/soc/qcom/x1e80100.c                                  | 31 ++++++-
 7 files changed, 188 insertions(+), 62 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/qcom,wsa8840.yaml b/Documentation/devicetree/bindings/sound/qcom,wsa8840.yaml
--- a/Documentation/devicetree/bindings/sound/qcom,wsa8840.yaml
+++ b/Documentation/devicetree/bindings/sound/qcom,wsa8840.yaml
@@ -41,7 +41,11 @@ properties:
     maxItems: 6
 
   '#sound-dai-cells':
-    const: 0
+    enum: [0, 1]
+    description: |
+      Zero selects the legacy speaker playback DAI.  With one cell, DAI 0 is
+      speaker playback and DAI 1 is the VISENSE protection-feedback sidechain.
 
   vdd-1p8-supply: true
   vdd-io-supply: true
@@ -75,7 +79,7 @@ examples:
             pinctrl-names = "default";
             pinctrl-0 = <&spkr_2_sd_n_active>;
             powerdown-gpios = <&lpass_tlmm 18 GPIO_ACTIVE_LOW>;
-            #sound-dai-cells = <0>;
+            #sound-dai-cells = <1>;
             sound-name-prefix = "SpkrRight";
             vdd-1p8-supply = <&vreg_l15b_1p8>;
             vdd-io-supply = <&vreg_l3g_1p2>;
diff --git a/arch/arm64/boot/dts/qcom/x1-asus-zenbook-a14.dtsi b/arch/arm64/boot/dts/qcom/x1-asus-zenbook-a14.dtsi
--- a/arch/arm64/boot/dts/qcom/x1-asus-zenbook-a14.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-asus-zenbook-a14.dtsi
@@ -277,7 +277,7 @@ wsa-dai-link {
 			link-name = "WSA Playback";
 
 			codec {
-				sound-dai = <&left_spkr>, <&right_spkr>,
+				sound-dai = <&left_spkr 0>, <&right_spkr 0>,
 					    <&swr0 0>, <&lpass_wsamacro 0>;
 			};
 
@@ -290,6 +290,28 @@ wsa-dai-link {
 				 sound-dai = <&q6apm>;
 			};
 		};
+
+		wsa-vi-dai-link {
+			link-name = "WSA VI Protection";
+
+			/*
+			 * A14 WSA8845 VISENSE feedback:
+			 * left/right slave VISENSE -> SWR0 DIN0 -> WSA macro VI ->
+			 * AudioReach WSA TX0.  ASoC models this as a companion
+			 * playback BE so it can be started with speaker rendering;
+			 * the SoundWire data direction remains slave-to-master.
+			 */
+			codec {
+				sound-dai = <&left_spkr 1>, <&right_spkr 1>,
+					    <&swr0 9>, <&lpass_wsamacro 2>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai WSA_CODEC_DMA_TX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
@@ -1490,7 +1512,7 @@ left_spkr: speaker@0,0 {
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "SpkrLeft";
 		vdd-1p8-supply = <&vreg_l15b_1p8>;
 		vdd-io-supply = <&vreg_l12b_1p2>;
@@ -1503,7 +1525,7 @@ right_spkr: speaker@0,1 {
