#!/bin/sh

UUID=asus-a14-modes@omerfaruknehir

if command -v gnome-extensions >/dev/null 2>&1 && \
   gnome-extensions list 2>/dev/null | grep -qx "$UUID"; then
    # Always keep the extension enabled. On stock GNOME it provides the complete
    # five-mode A14 tile plus OSD. On the rebuilt native five-profile GNOME it
    # detects /usr/share/asus-zenbook-a14-ec/native-gnome-five-profile and becomes
    # OSD-only, so there is still exactly one Power Mode control.
    gnome-extensions enable "$UUID" >/dev/null 2>&1 || true
fi

true
