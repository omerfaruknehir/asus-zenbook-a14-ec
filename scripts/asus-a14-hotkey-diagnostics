#!/bin/sh
set -eu

hid_device=$(find /sys/bus/hid/devices -maxdepth 1 -type l -name '*:0B05:0220.*' -print -quit 2>/dev/null || true)
[ -n "$hid_device" ] || {
  echo 'ASUS 0B05:0220 HID device not found.' >&2
  exit 1
}

echo "HID device: $hid_device"
echo "Driver: $(basename "$(readlink -f "$hid_device/driver")")"

echo
echo 'Input capabilities:'
for input in "$hid_device"/input/input*; do
  [ -d "$input" ] || continue
  name=$(cat "$input/name" 2>/dev/null || echo unknown)
  printf '\n%s (%s)\n' "$(basename "$input")" "$name"
  for cap in ev key led sw; do
    [ -r "$input/capabilities/$cap" ] && printf '  %-4s %s\n' "$cap" "$(cat "$input/capabilities/$cap")"
  done
  for event in "$input"/event*; do
    [ -e "$event" ] && printf '  node /dev/input/%s\n' "$(basename "$event")"
  done
done

echo
echo 'LED class devices:'
for led in /sys/class/leds/*; do
  [ -e "$led" ] || continue
  case "$(basename "$led")" in
    *micmute*|*camera*|*kbd_backlight*)
      printf '  %s: %s/%s trigger=%s\n' \
        "$(basename "$led")" \
        "$(cat "$led/brightness" 2>/dev/null || echo '?')" \
        "$(cat "$led/max_brightness" 2>/dev/null || echo '?')" \
        "$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$led/trigger" 2>/dev/null || true)"
      ;;
  esac
done

echo
echo 'Camera-related media and video nodes:'
for node in /dev/video* /dev/media*; do
  [ -e "$node" ] && printf '  %s\n' "$node"
done

echo
echo 'V4L2 privacy controls:'
privacy_found=false
if command -v v4l2-ctl >/dev/null 2>&1; then
  for node in /dev/video*; do
    [ -e "$node" ] || continue
    controls=$(v4l2-ctl -d "$node" --list-ctrls 2>/dev/null || true)
    if printf '%s\n' "$controls" | grep -qi privacy; then
      privacy_found=true
      echo "  $node"
      printf '%s\n' "$controls" | grep -i privacy | sed 's/^/    /'
    fi
  done
  [ "$privacy_found" = true ] || echo '  none exposed by current V4L2 nodes'
else
  echo '  v4l2-ctl unavailable; install package: v4l-utils'
fi

echo
echo 'Legacy mic-LED implementation search:'
echo '  Run this to locate the removed bridge source/backups:'
echo "  sudo grep -RnsE 'platform::micmute|a14[_-]kbd[_-]led|micmute' \\\"
echo '    /usr/src /var/lib/dkms /root/a14-hid-cleanup-* \'
echo '    /home/omerf/a14-kbd-helper-backup-* 2>/dev/null'

hidraw=$(find "$hid_device" -path '*/hidraw/hidraw*' -print -quit 2>/dev/null || true)
if [ -n "$hidraw" ]; then
  echo
  echo "Raw HID node: /dev/$(basename "$hidraw")"
else
  echo
  echo 'No hidraw node is exposed by this bound driver; hid-tools is not required.'
  echo 'Fn-lock now uses the known ASUS 0x5A/D0/4E feature report directly.'
fi
