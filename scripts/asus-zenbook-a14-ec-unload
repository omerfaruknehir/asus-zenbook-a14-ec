#!/bin/sh
set -u
I2C_DEV=/sys/bus/platform/devices/b94000.i2c

# hid_asus_ec references an exported symbol from asus_zenbook_a14_ec.  Remove
# the dependent first; otherwise the EC removal fails with EBUSY and an upgrade
# can silently leave the previous EC/HID pair resident in RAM.
if grep -q '^hid_asus_ec ' /proc/modules 2>/dev/null; then
  if ! modprobe -r hid_asus_ec; then
    echo "Failed to unload A14 HID hotkey module; refusing to leave mixed module versions" >&2
    exit 1
  fi
fi

if grep -q '^asus_zenbook_a14_ec ' /proc/modules 2>/dev/null; then
  if ! modprobe -r asus_zenbook_a14_ec; then
    echo "Failed to unload A14 EC module" >&2
    exit 1
  fi
fi

# The EC mailbox driver asks the Qualcomm I2C controller to runtime-suspend on
# removal.  Give that transition a bounded moment to complete before systemd
# considers the service stopped.
i=0
while [ -r "$I2C_DEV/power/runtime_status" ]; do
  status=$(cat "$I2C_DEV/power/runtime_status" 2>/dev/null || true)
  [ "$status" = suspended ] && break
  i=$((i + 1))
  [ "$i" -ge 20 ] && break
  sleep 0.05
done

exit 0
