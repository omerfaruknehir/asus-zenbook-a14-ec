#!/bin/sh
set -eu

EC_SERVICE=asus-zenbook-a14-ec.service
BRIDGE_SERVICE=asus-zenbook-a14-ppd-bridge.service
PPD_SERVICE=power-profiles-daemon.service

find_hwmon() {
  for d in /sys/class/hwmon/hwmon*; do
    [ -r "$d/name" ] || continue
    [ "$(cat "$d/name")" = "asus_zenbook_a14_ec" ] && { printf '%s\n' "$d"; return 0; }
  done
  return 1
}

profile_path=/sys/devices/platform/asus_zenbook_a14_ec/profile
hwmon=$(find_hwmon 2>/dev/null || true)

refresh_driver_paths() {
  hwmon=$(find_hwmon 2>/dev/null || true)
}

need_driver() {
  refresh_driver_paths
  [ -n "$hwmon" ] && [ -e "$profile_path" ] || {
    echo "asus_zenbook_a14_ec is not loaded" >&2
    echo "Start it with: sudo systemctl start $EC_SERVICE" >&2
    exit 1
  }
}

need_root() {
  [ "$(id -u)" -eq 0 ] || {
    echo "This command needs root. Run it through sudo." >&2
    exit 1
  }
}

unit_state() {
  systemctl is-active "$1" 2>/dev/null || printf 'inactive\n'
}

standard_platform_profile_present() {
  for name in /sys/class/platform-profile/platform-profile-*/name; do
    [ -r "$name" ] || continue
    grep -qx 'asus-zenbook-a14-ec' "$name" && return 0
  done
  return 1
}

show_status() {
  refresh_driver_paths
  if [ -z "$hwmon" ] || [ ! -e "$profile_path" ]; then
    echo 'EC driver: not loaded'
    printf 'EC service: %s\n' "$(unit_state "$EC_SERVICE")"
  else
    echo 'EC driver: loaded'
    printf 'profile: %s\n' "$(cat "$profile_path")"
    [ -r "$hwmon/temp1_input" ] && awk '{printf "EC temperature: %.1f C\n", $1/1000}' "$hwmon/temp1_input"
    [ -r "$hwmon/fan1_input" ] && printf 'left fan: %s RPM (PWM %s)\n' "$(cat "$hwmon/fan1_input")" "$(cat "$hwmon/pwm1")"
    [ -r "$hwmon/fan2_input" ] && printf 'right fan: %s RPM (PWM %s)\n' "$(cat "$hwmon/fan2_input")" "$(cat "$hwmon/pwm2")"
    [ -r "$hwmon/pwm1_enable" ] && printf 'fan mode: %s\n' "$( [ "$(cat "$hwmon/pwm1_enable")" = 1 ] && echo manual || echo automatic )"
    printf 'EC service: %s\n' "$(unit_state "$EC_SERVICE")"
  fi
  if [ -r /sys/class/leds/asus::kbd_backlight/brightness ]; then
    printf 'keyboard backlight: %s/%s\n' \
      "$(cat /sys/class/leds/asus::kbd_backlight/brightness)" \
      "$(cat /sys/class/leds/asus::kbd_backlight/max_brightness)"
  fi
  printf 'system power-profiles-daemon: %s\n' "$(unit_state "$PPD_SERVICE")"
  printf 'A14 PPD bridge: %s\n' "$(unit_state "$BRIDGE_SERVICE")"
  if standard_platform_profile_present; then
    echo 'standard platform_profile backend: available'
  else
    echo 'standard platform_profile backend: unavailable (optional bridge can be enabled)'
  fi
}

read_number() {
  file=$1
  [ -r "$file" ] || { printf '0\n'; return; }
  value=$(cat "$file" 2>/dev/null || printf '0')
  case "$value" in ''|*[!0-9]*) printf '0\n';; *) printf '%s\n' "$value";; esac
}

fan_test_restore_auto() {
  if [ -n "${hwmon:-}" ] && [ -w "$hwmon/pwm1_enable" ]; then
    printf '2\n' >"$hwmon/pwm1_enable" 2>/dev/null || true
  fi
}

fan_test() {
  need_root
  if ! systemctl is-active --quiet "$EC_SERVICE"; then
    echo "Starting hardened EC service..."
    systemctl start "$EC_SERVICE"
    sleep 2
  fi
  need_driver

  for f in fan1_input fan2_input pwm1 pwm2 pwm1_enable temp1_input; do
    [ -e "$hwmon/$f" ] || {
      echo "Missing expected hwmon interface: $hwmon/$f" >&2
      exit 1
    }
  done

  trap 'fan_test_restore_auto' EXIT HUP INT TERM
  fan_test_restore_auto
  sleep 2

  base_left=$(read_number "$hwmon/fan1_input")
  base_right=$(read_number "$hwmon/fan2_input")
  base_temp=$(read_number "$hwmon/temp1_input")
  printf 'Automatic baseline: left=%s RPM, right=%s RPM, temperature=' "$base_left" "$base_right"
  awk -v t="$base_temp" 'BEGIN { printf "%.1f C\n", t/1000 }'

  if [ "$base_temp" -ge 80000 ]; then
    echo 'Refusing manual fan test: EC temperature is already at least 80 C.' >&2
    exit 1
  fi

  printf '1\n' >"$hwmon/pwm1_enable"
  printf '160\n' >"$hwmon/pwm1"
  printf '160\n' >"$hwmon/pwm2"
  echo 'Testing both fans at PWM 160...'
  sleep 5
  low_left=$(read_number "$hwmon/fan1_input")
  low_right=$(read_number "$hwmon/fan2_input")
  printf 'PWM 160: left=%s RPM, right=%s RPM\n' "$low_left" "$low_right"

  printf '220\n' >"$hwmon/pwm1"
  printf '220\n' >"$hwmon/pwm2"
  echo 'Testing both fans at PWM 220...'
  sleep 5
  high_left=$(read_number "$hwmon/fan1_input")
  high_right=$(read_number "$hwmon/fan2_input")
  high_temp=$(read_number "$hwmon/temp1_input")
  printf 'PWM 220: left=%s RPM, right=%s RPM, temperature=' "$high_left" "$high_right"
  awk -v t="$high_temp" 'BEGIN { printf "%.1f C\n", t/1000 }'

  fan_test_restore_auto
  trap - EXIT HUP INT TERM
  sleep 2

  result=0
  if [ "$low_left" -le 0 ] || [ "$low_right" -le 0 ] || [ "$high_left" -le 0 ] || [ "$high_right" -le 0 ]; then
    echo 'FAIL: one or both tachometer channels returned zero.' >&2
    result=1
  fi
  if [ "$high_left" -le "$low_left" ]; then
    echo 'FAIL: left fan did not speed up between PWM 160 and 220.' >&2
    result=1
  fi
  if [ "$high_right" -le "$low_right" ]; then
    echo 'FAIL: right fan did not speed up between PWM 160 and 220.' >&2
    result=1
  fi

  echo 'Fan control restored to EC automatic mode.'
  if [ "$result" -eq 0 ]; then
    echo 'PASS: both fan tachometers responded and both fans accelerated.'
  fi
  show_status
  return "$result"
}

bridge_status() {
  printf 'system power-profiles-daemon: %s\n' "$(unit_state "$PPD_SERVICE")"
  printf 'A14 PPD bridge: %s\n' "$(unit_state "$BRIDGE_SERVICE")"
  if standard_platform_profile_present; then
    echo 'standard platform_profile backend: available; bridge is normally unnecessary'
  else
    echo 'standard platform_profile backend: unavailable'
  fi
}

bridge_enable() {
  need_root
  [ -e "/usr/lib/systemd/system/$BRIDGE_SERVICE" ] || {
    echo "$BRIDGE_SERVICE is not installed" >&2
    exit 1
  }
  need_driver
  echo "Enabling the fallback replaces power-profiles-daemon while active."
  systemctl mask --now "$PPD_SERVICE" 2>/dev/null || true
  systemctl unmask "$BRIDGE_SERVICE" 2>/dev/null || true
  systemctl enable --now "$BRIDGE_SERVICE"
  bridge_status
}

bridge_disable() {
  need_root
  systemctl disable --now "$BRIDGE_SERVICE" 2>/dev/null || true
  systemctl unmask "$PPD_SERVICE" 2>/dev/null || true
  systemctl enable --now "$PPD_SERVICE" 2>/dev/null || systemctl start "$PPD_SERVICE" 2>/dev/null || true
  bridge_status
}

usage() {
  cat <<'USAGE'
Usage:
  asus-a14-control status
  sudo asus-a14-control fan-test
  sudo asus-a14-control profile quiet|balanced|performance
  sudo asus-a14-control auto
  sudo asus-a14-control manual PWM
  sudo asus-a14-control fan left|right PWM
  sudo asus-a14-control backlight 0|1|2|3
  asus-a14-control ppd-bridge status
  sudo asus-a14-control ppd-bridge enable
  sudo asus-a14-control ppd-bridge disable

fan-test briefly exercises both fans at safe PWM values, checks both tachometer
channels, and always restores firmware automatic fan control.

Manual PWM values are 75-255. A kernel safety monitor restores automatic
fan control if temperatures become unsafe or temperature readings fail.

The PPD bridge is only a fallback for kernels that cannot expose this driver's
standard platform_profile device. It conflicts with power-profiles-daemon and
is never enabled automatically.
USAGE
}

cmd=${1:-status}
case "$cmd" in
  status)
    show_status
    ;;
  fan-test)
    fan_test
    ;;
  profile)
    need_driver; need_root
    case "${2:-}" in quiet|balanced|performance) printf '%s\n' "$2" >"$profile_path";; *) usage; exit 2;; esac
    show_status
    ;;
  auto)
    need_driver; need_root
    printf '2\n' >"$hwmon/pwm1_enable"
    show_status
    ;;
  manual)
    need_driver; need_root
    pwm=${2:-}
    case "$pwm" in ''|*[!0-9]*) usage; exit 2;; esac
    if [ "$pwm" -lt 75 ] || [ "$pwm" -gt 255 ]; then
      echo "PWM must be 75-255" >&2; exit 2
    fi
    printf '1\n' >"$hwmon/pwm1_enable"
    printf '%s\n' "$pwm" >"$hwmon/pwm1"
    printf '%s\n' "$pwm" >"$hwmon/pwm2"
    show_status
    ;;
  fan)
    need_driver; need_root
    side=${2:-}; pwm=${3:-}
    case "$pwm" in ''|*[!0-9]*) usage; exit 2;; esac
    if [ "$pwm" -lt 75 ] || [ "$pwm" -gt 255 ]; then
      echo "PWM must be 75-255" >&2; exit 2
    fi
    printf '1\n' >"$hwmon/pwm1_enable"
    case "$side" in left) printf '%s\n' "$pwm" >"$hwmon/pwm1";; right) printf '%s\n' "$pwm" >"$hwmon/pwm2";; *) usage; exit 2;; esac
    show_status
    ;;
  backlight)
    need_root
    level=${2:-}
    case "$level" in 0|1|2|3) printf '%s\n' "$level" >/sys/class/leds/asus::kbd_backlight/brightness;; *) usage; exit 2;; esac
    ;;
  ppd-bridge)
    case "${2:-status}" in
      status) bridge_status;;
      enable) bridge_enable;;
      disable) bridge_disable;;
      *) usage; exit 2;;
    esac
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
