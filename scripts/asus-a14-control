#!/bin/sh
set -eu

EC_SERVICE=asus-zenbook-a14-ec.service
BRIDGE_SERVICE=asus-zenbook-a14-ppd-bridge.service
PPD_SERVICE=power-profiles-daemon.service

find_hwmon() {
  for d in /sys/class/hwmon/hwmon*; do
    [ -r "$d/name" ] || continue
    [ "$(cat "$d/name")" = "asus_zenbook_a14_ec" ] && { printf '%s\n' "$d"; return 0; }
  done
  return 1
}

profile_path=/sys/devices/platform/asus_zenbook_a14_ec/profile
whisper_level_path=/sys/devices/platform/asus_zenbook_a14_ec/whisper_level
hwmon=$(find_hwmon 2>/dev/null || true)

need_driver() {
  [ -n "$hwmon" ] && [ -e "$profile_path" ] || {
    echo "asus_zenbook_a14_ec is not loaded" >&2
    exit 1
  }
}

need_root() {
  [ "$(id -u)" -eq 0 ] || {
    echo "This command needs root. Run it through sudo." >&2
    exit 1
  }
}

unit_state() {
  systemctl is-active "$1" 2>/dev/null || printf 'inactive\n'
}

standard_platform_profile_present() {
  for name in /sys/class/platform-profile/platform-profile-*/name; do
    [ -r "$name" ] || continue
    grep -qx 'asus-zenbook-a14-ec' "$name" && return 0
  done
  return 1
}

show_status() {
  need_driver
  profile=$(cat "$profile_path")
  printf 'profile: %s\n' "$profile"
  if [ "$profile" = whisper ] && [ -r "$whisper_level_path" ]; then
    level=$(cat "$whisper_level_path")
    case "$level" in
      0) detail='fanless / light throttling' ;;
      1) detail='fanless / medium throttling' ;;
      2) detail='fanless / strong throttling' ;;
      *) detail='native Quiet cooling / strong throttling' ;;
    esac
    printf 'whisper state: %s (%s)\n' "$level" "$detail"
  fi
  [ -r "$hwmon/temp1_input" ] && awk '{printf "EC temperature: %.1f C\n", $1/1000}' "$hwmon/temp1_input"

  fan_enable=0
  [ -r "$hwmon/pwm1_enable" ] && fan_enable=$(cat "$hwmon/pwm1_enable")
  if [ "$fan_enable" = 1 ]; then
    [ -r "$hwmon/fan1_input" ] && printf 'left fan: %s RPM (manual PWM %s)\n' "$(cat "$hwmon/fan1_input")" "$(cat "$hwmon/pwm1")"
    [ -r "$hwmon/fan2_input" ] && printf 'right fan: %s RPM (manual PWM %s)\n' "$(cat "$hwmon/fan2_input")" "$(cat "$hwmon/pwm2")"
    printf 'fan mode: manual\n'
  else
    [ -r "$hwmon/fan1_input" ] && printf 'left fan: %s RPM\n' "$(cat "$hwmon/fan1_input")"
    [ -r "$hwmon/fan2_input" ] && printf 'right fan: %s RPM\n' "$(cat "$hwmon/fan2_input")"
    printf 'fan mode: automatic (ASUS firmware owns PWM)\n'
  fi

  if [ -r /sys/class/leds/asus::kbd_backlight/brightness ]; then
    printf 'keyboard backlight: %s/%s\n' \
      "$(cat /sys/class/leds/asus::kbd_backlight/brightness)" \
      "$(cat /sys/class/leds/asus::kbd_backlight/max_brightness)"
  fi
  printf 'EC service: %s\n' "$(unit_state "$EC_SERVICE")"
  printf 'system power-profiles-daemon: %s\n' "$(unit_state "$PPD_SERVICE")"
  printf 'A14 PPD fallback bridge: %s\n' "$(unit_state "$BRIDGE_SERVICE")"
  if standard_platform_profile_present; then
    echo 'GNOME profile backend: native Linux platform_profile + A14 mode extension'
  else
    echo 'GNOME profile backend: A14 PPD-compatible fallback'
  fi
}

bridge_status() {
  printf 'system power-profiles-daemon: %s\n' "$(unit_state "$PPD_SERVICE")"
  printf 'A14 PPD bridge: %s\n' "$(unit_state "$BRIDGE_SERVICE")"
}

bridge_enable() {
  need_root; need_driver
  systemctl mask --now "$PPD_SERVICE" 2>/dev/null || true
  systemctl unmask "$BRIDGE_SERVICE" 2>/dev/null || true
  systemctl enable --now "$BRIDGE_SERVICE"
  bridge_status
}

bridge_disable() {
  need_root
  systemctl disable --now "$BRIDGE_SERVICE" 2>/dev/null || true
  systemctl unmask "$PPD_SERVICE" 2>/dev/null || true
  systemctl enable --now "$PPD_SERVICE" 2>/dev/null || systemctl start "$PPD_SERVICE" 2>/dev/null || true
  bridge_status
}

refresh_backend() {
  need_root
  if [ -x /usr/libexec/asus-zenbook-a14-profile-integration ]; then
    /usr/libexec/asus-zenbook-a14-profile-integration
  elif [ -x "$(dirname "$0")/asus-zenbook-a14-profile-integration" ]; then
    "$(dirname "$0")/asus-zenbook-a14-profile-integration"
  else
    echo 'A14 profile integration helper is not installed.' >&2
    exit 1
  fi
}

usage() {
  cat <<'USAGE'
Usage:
  asus-a14-control status
  sudo asus-a14-control profile whisper|quiet|normal|turbo|full-speed
  sudo asus-a14-control auto
  sudo asus-a14-control manual PWM
  sudo asus-a14-control fan left|right PWM
  sudo asus-a14-control backlight BRIGHTNESS_0_TO_255
  sudo asus-a14-control profile-backend refresh
  asus-a14-control ppd-bridge status
  sudo asus-a14-control ppd-bridge enable|disable

Ordered modes:
  whisper     Minimum-disturbance policy. Tries 0 RPM and progressively caps
              CPU/GPU; silently falls back to native ASUS Quiet cooling when
              required, then retries fanless operation after cooling down.
  quiet       Native ASUS Quiet firmware mode.
  normal      Native ASUS Normal firmware mode.
  turbo       Native ASUS Turbo firmware mode.
  full-speed  Native ASUS Full Speed firmware mode.

Fn+F cycles: Whisper -> Quiet -> Normal -> Turbo -> Full Speed -> Whisper.
Direct manual PWM values remain 75-255 and are treated as CUSTOM.
USAGE
}

cmd=${1:-status}
case "$cmd" in
  status)
    show_status
    ;;
  profile)
    need_driver; need_root
    case "${2:-}" in
      whisper|quiet|normal|turbo|full-speed)
        printf '%s\n' "$2" >"$profile_path"
        ;;
      balanced) printf 'normal\n' >"$profile_path" ;;
      performance) printf 'turbo\n' >"$profile_path" ;;
      *) usage; exit 2 ;;
    esac
    show_status
    ;;
  auto)
    need_driver; need_root
    printf '2\n' >"$hwmon/pwm1_enable"
    show_status
    ;;
  manual)
    need_driver; need_root
    pwm=${2:-}
    case "$pwm" in ''|*[!0-9]*) usage; exit 2;; esac
    if [ "$pwm" -lt 75 ] || [ "$pwm" -gt 255 ]; then
      echo "PWM must be 75-255" >&2; exit 2
    fi
    printf '1\n' >"$hwmon/pwm1_enable"
    printf '%s\n' "$pwm" >"$hwmon/pwm1"
    printf '%s\n' "$pwm" >"$hwmon/pwm2"
    show_status
    ;;
  fan)
    need_driver; need_root
    side=${2:-}; pwm=${3:-}
    case "$pwm" in ''|*[!0-9]*) usage; exit 2;; esac
    if [ "$pwm" -lt 75 ] || [ "$pwm" -gt 255 ]; then
      echo "PWM must be 75-255" >&2; exit 2
    fi
    printf '1\n' >"$hwmon/pwm1_enable"
    case "$side" in left) printf '%s\n' "$pwm" >"$hwmon/pwm1";; right) printf '%s\n' "$pwm" >"$hwmon/pwm2";; *) usage; exit 2;; esac
    show_status
    ;;
  backlight)
    need_root
    level=${2:-}
    case "$level" in ''|*[!0-9]*) usage; exit 2;; esac
    if [ "$level" -gt 255 ]; then
      echo "Keyboard brightness must be 0-255" >&2; exit 2
    fi
    printf '%s\n' "$level" >/sys/class/leds/asus::kbd_backlight/brightness
    ;;
  profile-backend)
    case "${2:-}" in refresh) refresh_backend;; *) usage; exit 2;; esac
    ;;
  ppd-bridge)
    case "${2:-status}" in
      status) bridge_status;; enable) bridge_enable;; disable) bridge_disable;; *) usage; exit 2;;
    esac
    ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
