+fn search_for_qcom_cpu_thermal_zone() -> Option<PathBuf> {
+    trace!("Searching for Qualcomm CPU thermal zones…");
+
+    let mut candidates: Vec<(String, PathBuf)> = Vec::new();
+
+    for path in (glob("/sys/class/thermal/thermal_zone*").unwrap()).flatten() {
+        if let Ok(read_type) = read_parsed::<String>(path.join("type")) {
+            let read_type = read_type.trim_end().to_string();
+            let lower = read_type.to_lowercase();
+
+            // Accept CPU/core clusters, but explicitly reject GPU/video/camera style
+            // zones so the Processor page does not show a GPU/display temperature.
+            let looks_cpu = lower.starts_with("cpu") || lower.starts_with("cpuss");
+            let reject = lower.starts_with("gpu")
+                || lower.starts_with("gpuss")
+                || lower.contains("video")
+                || lower.contains("camera")
+                || lower.contains("aoss")
+                || lower.contains("mem")
+                || lower.contains("pm")
+                || lower.contains("nsp");
+
+            if looks_cpu && !reject && path.join("temp").exists() {
+                candidates.push((read_type, path.join("temp")));
+            }
+        }
+    }
+
+    // Prefer the hottest currently readable CPU-related zone. This gives a useful
+    // package/cluster-ish temperature on Snapdragon laptops where there is no
+    // single x86-style package sensor.
+    candidates
+        .into_iter()
+        .filter_map(|(name, path)| {
+            read_sysfs_thermal(&path)
+                .ok()
+                .map(|temp| (name, path, temp))
+        })
+        .max_by(|(_, _, a), (_, _, b)| a.total_cmp(b))
+        .map(|(name, path, temp)| {
+            debug!("CPU temperature sensor located at {path:?} ({name}, fallback Qualcomm thermal zone, currently {temp:.1} °C)");
+            path
+        })
+}
