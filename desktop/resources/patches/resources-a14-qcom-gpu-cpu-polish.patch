+fn qcom_physical_topology_from_sysfs() -> (Option<usize>, Option<usize>) {
+    let mut packages = BTreeSet::new();
+    let mut cores = BTreeSet::new();
+
+    for cpu in glob("/sys/devices/system/cpu/cpu[0-9]*").unwrap().flatten() {
+        let topology = cpu.join("topology");
+        if !topology.exists() {
+            continue;
+        }
+
+        let package = read_parsed::<isize>(topology.join("physical_package_id")).unwrap_or(0);
+        let cluster = read_parsed::<isize>(topology.join("cluster_id")).unwrap_or(-1);
+        let core = read_parsed::<isize>(topology.join("core_id")).unwrap_or_else(|_| {
+            cpu.file_name()
+                .and_then(|name| name.to_string_lossy().strip_prefix("cpu").map(str::to_string))
+                .and_then(|id| id.parse::<isize>().ok())
+                .unwrap_or(-1)
+        });
+
+        packages.insert(package);
+        cores.insert((package, cluster, core));
+    }
+
+    let physical_cpus = (!cores.is_empty()).then_some(cores.len());
+    let sockets = (!packages.is_empty()).then_some(packages.len().max(1));
+
+    (physical_cpus, sockets)
+}
+
+fn fallback_virtualization_string() -> Option<String> {
+    let cpuinfo = std::fs::read_to_string("/proc/cpuinfo").ok()?;
+    let lower = cpuinfo.to_lowercase();
+
+    // ARM64 virtualization is not always reported by lscpu on device-tree boots.
+    // If the kernel exposes obvious ARM virtualization features, show that rather
+    // than leaving the CPU properties page as N/A. Otherwise be explicit that the
+    // running kernel did not report a usable value.
+    if lower.contains("\nfeatures") && (lower.contains(" vh") || lower.contains(" virt")) {
+        Some("ARM virtualization extensions".into())
+    } else {
+        Some("Not reported by kernel".into())
+    }
+}
+
 impl CpuInfo {
