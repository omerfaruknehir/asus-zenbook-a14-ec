+fn qcom_cpu_temperature() -> Result<f32> {
+    let mut temps = Vec::new();
+
+    for zone in glob("/sys/class/thermal/thermal_zone*")?.flatten() {
+        let Ok(zone_type) = read_parsed::<String>(zone.join("type")) else {
+            continue;
+        };
+
+        let zone_type = zone_type.trim().to_ascii_lowercase();
+        if !(zone_type.starts_with("cpu")
+            || zone_type.starts_with("cpuss")
+            || zone_type.contains("cpu")
+            || zone_type.contains("cpuss"))
+        {
+            continue;
+        }
+
+        if let Ok(temp) = read_sysfs_thermal(zone.join("temp")) {
+            temps.push(temp);
+        }
+    }
+
+    temps
+        .into_iter()
+        .reduce(f32::max)
+        .context("no Qualcomm CPU thermal-zone temperature found")
+}
