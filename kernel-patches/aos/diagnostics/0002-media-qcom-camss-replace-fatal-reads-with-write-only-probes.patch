From 0000000000000000000000000000000000001002 Mon Sep 17 00:00:00 2001
From: Omer Faruk Nehir <omerfaruknehir@gmail.com>
Date: Thu, 6 Aug 2026 02:00:00 +0300
Subject: [PATCH diagnostic 2/2] media: qcom: camss: replace fatal reads
 with write-only probes

The staged read of MAIN_CAM_AON_CAM_SEL_CTRL caused an abrupt platform reset.
Replace all diagnostic readback operations with write-only probes:

  stage 3: write the already-active AP value 0x000
  stage 4: write AON value 0x101, wait 1-2 ms, then restore AP value 0x000

The production provider now treats this register as write-only. These probes
remain diagnostic-only and never contact SSC.

Signed-off-by: Omer Faruk Nehir <omerfaruknehir@gmail.com>
---
 drivers/media/platform/qcom/camss/camss.c | 60 ++++++++---------------
 1 file changed, 21 insertions(+), 39 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 000000001001..000000001002 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -9,5 +9,6 @@
  */
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/kstrtox.h>
 #include <linux/interconnect.h>
@@ -152,12 +153,9 @@ static int qcom_camss_aon_diag_run(struct camss *camss, unsigned int stage)
 {
-	u32 before = 0;
-	u32 switched = 0;
-	u32 restored = 0;
 	bool clocks_held = false;
 	bool pm_held = false;
 	int ret = 0;
 
-	if (stage < 1 || stage > 5)
+	if (stage < 1 || stage > 4)
 		return -EINVAL;
 
 	mutex_lock(&camss->aon_lock);
@@ -198,51 +196,34 @@ static int qcom_camss_aon_diag_run(struct camss *camss, unsigned int stage)
 	if (stage == 2)
 		goto out_release;
 
-	before = readl(camss->cpas_top_base + X1E_CPAS_AON_CAM_SEL_CTRL);
-	dev_emerg(camss->dev,
-		  "AON-DIAG stage=%u initial read=%#x\n", stage, before);
-	if (stage == 3)
-		goto out_release;
-
-	if (stage == 4) {
+	if (stage == 3) {
 		dev_emerg(camss->dev,
-			  "AON-DIAG stage=4 write-current begin value=%#x\n",
-			  before);
-		writel(before,
+			  "AON-DIAG stage=3 AP write begin value=%#x\n",
+			  X1E_CPAS_AON_CAM_SEL_AP);
+		writel(X1E_CPAS_AON_CAM_SEL_AP,
 		       camss->cpas_top_base + X1E_CPAS_AON_CAM_SEL_CTRL);
-		switched = readl(camss->cpas_top_base +
-				 X1E_CPAS_AON_CAM_SEL_CTRL);
 		dev_emerg(camss->dev,
-			  "AON-DIAG stage=4 write-current readback=%#x\n",
-			  switched);
-		if (switched != before)
-			ret = -EIO;
+			  "AON-DIAG stage=3 AP write issued\n");
 		goto out_release;
 	}
 
 	dev_emerg(camss->dev,
-		  "AON-DIAG stage=5 AON switch begin value=%#x\n",
+		  "AON-DIAG stage=4 AON switch begin value=%#x\n",
 		  X1E_CPAS_AON_CAM_SEL_AON);
 	writel(X1E_CPAS_AON_CAM_SEL_AON,
 	       camss->cpas_top_base + X1E_CPAS_AON_CAM_SEL_CTRL);
-	switched = readl(camss->cpas_top_base +
-			 X1E_CPAS_AON_CAM_SEL_CTRL);
 	dev_emerg(camss->dev,
-		  "AON-DIAG stage=5 AON switch readback=%#x\n", switched);
+		  "AON-DIAG stage=4 AON switch issued\n");
+
+	usleep_range(1000, 2000);
 
 	dev_emerg(camss->dev,
-		  "AON-DIAG stage=5 AP restore begin value=%#x\n",
+		  "AON-DIAG stage=4 AP restore begin value=%#x\n",
 		  X1E_CPAS_AON_CAM_SEL_AP);
 	writel(X1E_CPAS_AON_CAM_SEL_AP,
 	       camss->cpas_top_base + X1E_CPAS_AON_CAM_SEL_CTRL);
-	restored = readl(camss->cpas_top_base +
-			 X1E_CPAS_AON_CAM_SEL_CTRL);
 	dev_emerg(camss->dev,
-		  "AON-DIAG stage=5 AP restore readback=%#x\n", restored);
-
-	if (switched != X1E_CPAS_AON_CAM_SEL_AON ||
-	    restored != X1E_CPAS_AON_CAM_SEL_AP)
-		ret = -EIO;
+		  "AON-DIAG stage=4 AP restore issued\n");
 
 out_release:
 	if (clocks_held)
-- 
2.51.0
